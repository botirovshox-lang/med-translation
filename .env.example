# Medical CAT Translator — конфигурация окружения
# Продакшен: /etc/medcat/env (подхватывается systemd-юнитом medcat.service)
# Локально: скопируйте в .env и экспортируйте перед запуском uvicorn

# Пароль входа в веб-интерфейс (SHA256 сверяется на бэкенде)
APP_PASSWORD=change-me

# OpenAI — перевод GPT-4o и обратный перевод для Medical QA
OPENAI_API_KEY=sk-...your-key-here...

# Anthropic (Claude) — второй поставщик, необязателен. Без ключа модели Claude
# не выбираются, кросс-проверка терм-листа (TERMCROSS_MODEL) пропускается.
# ANTHROPIC_API_KEY=sk-ant-...
# TERMCROSS_MODEL=claude-sonnet-5

# Google Cloud Translation v2 (нужен включённый Cloud Translation API + billing).
# При невалидном ключе система работает через бесплатный deep-translator + GPT-fallback.
GOOGLE_TRANSLATE_API_KEY=your-google-key-here

# Medical QA (структурные/числовые проверки + backcheck): 1 = включён (по умолчанию)
MEDICAL_TRANSLATION_QA_ENABLED=1
